[TEMPLATE]
# Paprika Lyrics — environment template.
#
# Copy this file to `.env` (which is git-ignored) and fill in your key:
#
#     cp .env.example .env
#
# Values are read once, at import of config.py. Real environment variables win
# over the file — a key exported in the shell is preferred to the one written
# here, so this file can never silently override a shell-level setting.

# Your Spicy Lyrics publishable API key (starts with 'sl_pk_').
# Secret keys ('sl_sk_') are strictly forbidden in client applications per SpicyLyrics
# Developer Terms and will be rejected. Without a key the app still works, but
# syllable-level (word-by-word) lyrics from the Spicy Lyrics API are unavailable
# and every track falls back to LRCLIB's line timings. The app prints a warning
# on startup when this is empty.
SPICY_API_KEY=

# Lyrics API root. Only change this if you run your own instance.
SPICY_BASE_URL=https://api.spicylyrics.org

# --- Optional overrides (defaults are shown for reference) -------------------

# Your local .ttml lyric library, for songs the online lookup gets wrong.
# Default: ./ttml (created on the first import; git-ignored).
# SPICY_TTML_DIR=E:\Lyrics\ttml

# Your imported fonts for the lyrics and the interface (.ttf/.otf/.woff/.woff2).
# Default: ./fonts (created on the first import; git-ignored).
# SPICY_FONT_DIR=E:\Fonts

# The Edge WebView2 profile that stores the UI's settings. Machine-local and
# large; deleting the folder is how you reset every preference at once.
# Default: ./.webview (git-ignored).
# SPICY_WEBVIEW_DIR=E:\Temp\spicy-webview

# How long a cached lyric payload stays fresh, in seconds. Default: 3 days (259200).
# Per SpicyLyrics Developer Terms Section 7, all cached responses and lyrics must
# be refetched or discarded within 30 days (maximum 2,592,000 seconds). No caching
# can be unbounded or set to 0 (never expire). Values <= 0 or invalid default to
# 3 days (259200), and values exceeding 30 days are clamped to 2,592,000 maximum.
# SPICY_CACHE_TTL_SECONDS=259200

# Verbose resolver/lyrics logging on stdout. Default: off.
# SPICY_DEBUG=0
