# Paprika Lyrics — environment template.
#
# Copy this file to `.env` (which is git-ignored) and fill in your key:
#
#     cp .env.example .env
#
# Values are read once, at import of config.py. Real environment variables win
# over the file — a key exported in the shell is preferred to the one written
# here, so this file can never silently override a shell-level setting.

# Your Spicy Lyrics API key. Without it the app still works, but syllable-level
# (word-by-word) lyrics from the Spicy Lyrics API are unavailable and every track
# falls back to LRCLIB's line timings. The app prints a warning on startup when
# this is empty.
SPICY_API_KEY=

# Lyrics API root. Only change this if you run your own instance.
SPICY_BASE_URL=https://api.spicylyrics.org

# --- Optional overrides (defaults are shown for reference) -------------------

# Your local .ttml lyric library, for songs the online lookup gets wrong.
# Default: ./ttml (created on the first import; git-ignored).
# SPICY_TTML_DIR=E:\Lyrics\ttml

# The Edge WebView2 profile that stores the UI's settings. Machine-local and
# large; deleting the folder is how you reset every preference at once.
# Default: ./.webview (git-ignored).
# SPICY_WEBVIEW_DIR=E:\Temp\spicy-webview

# How long a cached lyric payload stays fresh, in seconds. Default: 3 days.
# SPICY_CACHE_TTL_SECONDS=259200

# Verbose resolver/lyrics logging on stdout. Default: off.
# SPICY_DEBUG=0
